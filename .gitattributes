# Generated by `mise run svg` (scripts/gen-svg.sh) — don't show in diffs or
# count toward language stats.
assets/purr.svg -diff linguist-generated=true

# Generated by `dist generate` with CRLF endings; pin CRLF in the working tree
# so re-running dist produces no spurious diff. Mark generated for language stats.
wix/main.wxs text eol=crlf linguist-generated=true

# Bootstrap installers: their SHA-256 is compiled into script-installed binaries
# and must match the published release asset byte-for-byte, so never let a
# Windows checkout convert them to CRLF.
scripts/install.sh text eol=lf
scripts/install.ps1 text eol=lf
